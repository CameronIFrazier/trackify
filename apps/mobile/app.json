{
  "expo": {
    "name": "trackify.lt",
    "slug": "mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2e7d32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cameronfrazier.trackify",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Trackify uses the camera so you can take a photo of a food to estimate its nutrients.",
        "NSPhotoLibraryUsageDescription": "Trackify accesses your photos so you can choose a food photo to estimate its nutrients."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2e7d32"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cameronfrazier.trackify"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "adcca836-d39b-48e8-ae70-7ea81f3eb534"
      }
    }
  }
}
